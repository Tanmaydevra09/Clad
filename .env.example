# ── Environment configuration for Clad Insurance Platform ─────────────────
# Copy to .env and fill in your values.
# NEVER commit .env to git.

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Local dev (Docker Compose): mongodb://localhost:27017
# Atlas free tier: mongodb+srv://user:pass@cluster.mongodb.net/
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=clad_insurance

# ── Redis ────────────────────────────────────────────────────────────────────
# Local dev: redis://localhost:6379/0
# Redis Cloud / Upstash: rediss://user:pass@host:port/0
REDIS_URL=redis://localhost:6379/0

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Local dev (Docker Compose): localhost:9092
# Upstash Kafka: https://upstash.com/kafka
KAFKA_BROKERS=localhost:9092

# For Upstash / cloud Kafka (SASL authentication):
# KAFKA_SASL_USERNAME=your-sasl-username
# KAFKA_SASL_PASSWORD=your-sasl-password

# ── Razorpay (Test Mode) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_SdtXKcSuPhPgo8
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ── Claude Vision (Anthropic) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...your-key-here

# ── Weather / AQI APIs ───────────────────────────────────────────────────────
AQICN_TOKEN=f01a354ce6bfcb14defbee7a1cbee54108f7a63f
TOMORROW_IO_KEY=fj3dCUUP19AYByhVG3OhWgDpuF5Rnlgz

# ── Snowflake (Analytics) ────────────────────────────────────────────────────
# Leave blank to disable ETL — app works normally without Snowflake
SNOWFLAKE_ACCOUNT=      # e.g. abc12345.us-east-1
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=CLAD_ETL_WH
SNOWFLAKE_DATABASE=CLAD_DB
SNOWFLAKE_SCHEMA=ANALYTICS

# ── App Config ───────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*       # comma-separated, or * for all
LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
