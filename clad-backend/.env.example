# Clad Backend — Environment Variables
# Copy this to .env and fill in your keys

# ── Anthropic (Claude Vision) ──────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Razorpay (Payouts) ────────────────────────────────────
# Get from: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_SdtXKcSuPhPgo8
RAZORPAY_KEY_SECRET=

# ── Weather APIs (optional — defaults already hardcoded) ──
# AQICN token: https://aqicn.org/data-platform/token/
AQICN_TOKEN=f01a354ce6bfcb14defbee7a1cbee54108f7a63f

# Tomorrow.io key: https://app.tomorrow.io/
TOMORROW_IO_KEY=fj3dCUUP19AYByhVG3OhWgDpuF5Rnlgz

# OpenWeatherMap key: https://openweathermap.org/api (free tier, 1M calls/mo)
# Primary rain source — uses live radar + ground stations (much better India monsoon coverage)
# Sign up free → Dashboard → API keys → copy default key
OPENWEATHER_KEY=your-owm-key-here

# ── CORS (for deployed frontend) ──────────────────────────
# Set to your Vercel frontend URL in production
ALLOWED_ORIGINS=*
